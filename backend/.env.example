# Copy this file to .env and fill in YOUR OWN values. Never commit .env.
PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string. Keep the database name /social_media at the end.
MONGO_URI=mongodb+srv://gyanendrackt058_db_user:Gyanu2003@<cluster-host>/social_media?retryWrites=true&w=majority

# Long random text, at least 32 characters
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# Frontend address(es) allowed to call this API. Separate several with commas.
CLIENT_URL=http://localhost:5173

# Cloudinary (Dashboard > Settings > API Keys)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Only used by: npm run seed:admin  (choose your own strong password)
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=choose_a_strong_password
